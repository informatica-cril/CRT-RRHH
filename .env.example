APP_NAME="CRT RRHH"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://crtrrhh.crtbcn.cat

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
# Producció: 'warning'. 'debug' omple el disc (log sense rotació si el stack no és 'daily').
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=portal_empleado
DB_USERNAME=crt_app
DB_PASSWORD=

MAIL_MAILER=smtp
MAIL_HOST=smtp.ionos.es
MAIL_PORT=587
MAIL_USERNAME=rrhh@crtbcn.cat
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=rrhh@crtbcn.cat
MAIL_FROM_NAME="CRT RRHH"

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

# Tot en un sol domini: web (/app), API (/api) i panell Inertia (/dashboard).
# SANCTUM_STATEFUL_DOMAINS ha de ser aquest domini perquè el panell i la web usen la sessió.
SANCTUM_STATEFUL_DOMAINS=crtrrhh.crtbcn.cat
# Buit = cookie de sessió lligada només a crtrrhh.crtbcn.cat (més segur que .crtbcn.cat).
SESSION_DOMAIN=

# CORS: només cal per a l'app mòbil (Capacitor). La web és del mateix domini i no en fa servir.
CORS_ALLOWED_ORIGINS=https://crtrrhh.crtbcn.cat

# Conexiones SOLO LECTURA a BDs existentes del centro (opcional, para integración futura)
# DB_LOGO_HOST=127.0.0.1
# DB_LOGO_DATABASE=logopedia_new_db
# DB_LOGO_USERNAME=crt_readonly
# DB_LOGO_PASSWORD=

# DB_AMBULATORIA_HOST=127.0.0.1
# DB_AMBULATORIA_DATABASE=crtbcn
# DB_AMBULATORIA_USERNAME=crt_readonly
# DB_AMBULATORIA_PASSWORD=

# DB_DOMICILIARIA_HOST=127.0.0.1
# DB_DOMICILIARIA_DATABASE=domi_crt
# DB_DOMICILIARIA_USERNAME=crt_readonly
# DB_DOMICILIARIA_PASSWORD=

# URL de l'API NOMÉS per a l'app mòbil (Capacitor, `npm run build` a app/).
# La web (`npm run build:web`) crida /api al mateix domini i ignora aquesta variable.
VITE_API_URL=https://crtrrhh.crtbcn.cat

# Integració amb domi (interoperabilitat bidireccional i verificació de domicili).
# Sense DOMI_HEALTH_URL tot degrada a Mode B (vàlid, sense hitos).
# CRT: integració preparada però DESACTIVADA fins que existeixi domi.crtbcn.cat.
# DOMI_HEALTH_URL=https://domi.crtbcn.cat/api/health
# DOMI_VERIFY_URL=https://domi.crtbcn.cat/api/verify-home
# PORTAL_DOMI_URL=https://domi.crtbcn.cat

# Geo-stack AUTOALLOTJAT (front). Buit = serveis públics OSM. Per no cedir coordenades
# a tercers, apuntar al tileserver/Overpass propis de domi si són fiables i en directe.
# VITE_TILE_URL=https://geo.crtbcn.cat/tiles/{z}/{x}/{y}.png
# VITE_TILE_ATTRIBUTION="© CRT · OpenStreetMap"
# VITE_TILE_MAX_ZOOM=19
# VITE_OVERPASS_URL=https://geo.crtbcn.cat/api/interpreter

# Identitat de dispositiu corporatiu (Hexnode) — mateixa clau a les dues apps.
# OBLIGATÒRIA per a l'enrolament de tablets: generar amb `openssl rand -hex 32`.
DISP_CORP_KEY=CLAU_ALEATORIA_64_HEX

# ── Segon factor (2FA) ── Vegeu docs/SEGON-FACTOR.md abans de tocar res.
# Estat actual: VOLUNTARI. Amb les dues variables buides/false, el 2FA només s'exigeix a qui
# s'ha enrolat pel seu compte; la resta de la plantilla entra com sempre.
# Nivell 1 — obligatori NOMÉS per a aquests rols (admin, coordinator, hr, worker):
# SECOND_FACTOR_ROLES=admin,hr
# Nivell 2 — obligatori per a tota la plantilla:
# SECOND_FACTOR_REQUIRED=true
# Kill-switch d'emergència (per sobre dels dos anteriors):
# SECOND_FACTOR_OFF=1

IA_LOCAL_URL=http://127.0.0.1:11434
IA_LOCAL_MODEL=qwen2.5vl:32b
IA_LOCAL_KEY=

# Origen de `php artisan crt:importa-portal` (portal de l'empleat antic de CRT).
# Només durant la importació; després s'esborra la BD d'origen.
# PORTAL_ORIGEN_DB_DATABASE=crt_portal_origen
