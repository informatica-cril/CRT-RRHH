APP_NAME="CRT SALUT RRHH"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://crtrrhh.crtbcn.cat

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=portal_empleado
DB_USERNAME=crt_app
DB_PASSWORD=

MAIL_MAILER=smtp
MAIL_HOST=smtp.ionos.es
MAIL_PORT=587
MAIL_USERNAME=rrhh@crtbcn.cat
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=rrhh@crtbcn.cat
MAIL_FROM_NAME="CRT SALUT RRHH"

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

SANCTUM_STATEFUL_DOMAINS=crtrrhh.crtbcn.cat
SESSION_DOMAIN=.crtbcn.cat

