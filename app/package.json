    "expo": "54",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^5.5.207",
    "pinia": "^3.0.4",
    "react": "19.2.0",
    "react-native": "0.83.4",
    "sharp": "^0.34.5",
